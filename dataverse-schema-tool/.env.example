# Copia este archivo a ".env" (sin ".example").
# Con la configuracion por defecto SOLO necesitas DATAVERSE_URL.
# No se requiere App Registration ni acceso al portal de Azure.

# URL de tu entorno de Dataverse (la misma que usaste con "pac auth create")
DATAVERSE_URL=https://orga14c5fc4.crm2.dynamics.com

# Modo de autenticacion:
#   device -> (por defecto) codigo de dispositivo en el navegador, usando el client ID
#             publico que Microsoft publica para scripts de Dataverse.
#   azcli  -> usa tu sesion de Azure CLI ("az login"). Alternativa si "device" es bloqueado.
AUTH_MODE=device

# OPCIONALES (dejar comentados si no tienes una App Registration propia):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
