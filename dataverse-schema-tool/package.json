{
  "name": "onboarding-dataverse-schema-tool",
  "version": "1.0.0",
  "description": "Creates/updates the Dataverse tables for the Onboarding and Micro-learning system.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dry-run": "node create-tables.mjs --dry-run",
    "create": "node create-tables.mjs",
    "remove-columns:dry-run": "node remove-columns.mjs --dry-run",
    "remove-columns": "node remove-columns.mjs",
    "reset:dry-run": "node reset-data.mjs --dry-run",
    "reset": "node reset-data.mjs",
    "seed:dry-run": "node seed-data.mjs --dry-run",
    "seed": "node seed-data.mjs",
    "seed:people:dry-run": "node seed-data.mjs --people-only --dry-run",
    "seed:people": "node seed-data.mjs --people-only",
    "migrate:person:dry-run": "node migrate-contact-to-person.mjs --dry-run",
    "migrate:person": "node migrate-contact-to-person.mjs",
    "audit:dry-run": "node enable-auditing.mjs --dry-run --org",
    "audit": "node enable-auditing.mjs",
    "audit:org": "node enable-auditing.mjs --org"
  },
  "dependencies": {
    "@azure/msal-node": "^2.13.1",
    "dotenv": "^16.4.5"
  }
}
